@	
s	engine	Set or get engine
s	exit	Exit ibus-daemon
s	list-engine	Show available engines
s	version	Show version
s	read-cache	Show the content of registry cache
s	write-cache	Create registry cache
s	address	Print the D-Bus address of ibus-daemon
s	read-config	Show the configuration values
s	reset-config	Reset the configuration values
s	emoji	Save emoji on dialog to clipboard
s	help	Show this information
@	engine
a	1	0
#	engine	1
d
@	exit
@	list-engine
@	version
@	read-cache
@	write-cache
@	address
@	read-config
@	reset-config
@	emoji
@	help
