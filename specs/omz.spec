@	
s	help	Print the help message
s	changelog	Print the changelog
s	plugin	Manage plugins
s	pr	Manage Oh My Zsh Pull Requests
s	reload	Reload the current zsh session
s	theme	Manage themes
s	update	Update Oh My Zsh
s	version	Show the version
@	help
@	changelog
@	plugin
s	disable	Disable plugin(s)
s	enable	Enable plugin(s)
s	info	Get information of a plugin
s	list	List all available Oh My Zsh plugins
s	load	Load plugin(s)
@	plugin disable
a	1	0
@	plugin enable
a	1	0
@	plugin info
a	1	0
@	plugin list
@	plugin load
a	1	0
@	pr
s	clean	Delete all PR branches (ohmyzsh/pull-*)
s	test	Fetch PR #NUMBER and rebase against master
@	pr clean
@	pr test
a	1	0
@	reload
@	theme
s	list	List all available Oh My Zsh themes
s	set	Set a theme in your .zshrc file
s	use	Load a theme
@	theme list
@	theme set
a	1	0
@	theme use
a	1	0
@	update
@	version
