@	
s	init	Initialize a new SakeApp project template for defining commands
s	clean	Remove all build artifacts generated by the SakeApp to ensure a clean state for future builds
s	edit	Open the SakeApp in Xcode (macOS only)
s	list	List all available commands defined in the SakeApp
s	build	Manually trigger a rebuild of the SakeApp
s	run	Run the specified command from the SakeApp
o	--help|-h	Show help information	p
o	--version	Show the version	
@	init
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
=	init	--config-path
t	filepaths
=	init	--sake-app-path
t	folders
@	clean
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
=	clean	--config-path
t	filepaths
=	clean	--sake-app-path
t	folders
@	edit
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
=	edit	--config-path
t	filepaths
=	edit	--sake-app-path
t	folders
@	list
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
o	--case-converting-strategy	Specify the strategy for converting command names' case	v
o	--sake-app-prebuilt-binary-path|-b	Specify the path to the prebuilt SakeApp binary	v
o	--json|-j	Output the list of commands in JSON format	
=	list	--config-path
t	filepaths
=	list	--sake-app-path
t	folders
=	list	--case-converting-strategy
v	keepOriginal	
v	toSnakeCase	
v	toKebabCase	
=	list	--sake-app-prebuilt-binary-path
t	filepaths
@	build
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
o	--show-bin-path	Print the path to the built SakeApp executable	
=	build	--config-path
t	filepaths
=	build	--sake-app-path
t	folders
@	run
o	--config-path|-c	Specify the path to the configuration file	vp
o	--sake-app-path|-s	Specify the path for the SakeApp package	vp
o	--case-converting-strategy	Specify the strategy for converting command names' case	v
o	--sake-app-prebuilt-binary-path|-b	Specify the path to the prebuilt SakeApp binary	v
a	1	0
=	run	--config-path
t	filepaths
=	run	--sake-app-path
t	folders
=	run	--case-converting-strategy
v	keepOriginal	
v	toSnakeCase	
v	toKebabCase	
=	run	--sake-app-prebuilt-binary-path
t	filepaths
#	run	1
d
