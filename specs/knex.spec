@	
s	init	Create a fresh knexfile
s	migrate:make	Create a named migration file
s	migrate:latest	Run all migrations that have not yet been run
s	migrate:up	Run the next or the specified migration that has not yet been run
s	migrate:rollback	Rollback the last batch of migrations performed
s	migrate:down	Undo the last or the specified migration that was already run
s	migrate:currentVersion	View the current version for the migration
s	migrate:unlock	Forcibly unlocks the migrations lock table
s	seed:make	Create a named seed file
s	seed:run	Run seed files
s	help	Display help for command
o	--version	Output the version number	v
o	--debug	Run with debugging	v
o	--knexfile	Specify the knexfile path	v
o	--knexpath	Specify the path to knex instance	v
o	--cwd	Specify the working directory	v
o	--client	Set DB client without a knexfile	v
o	--connection	Set DB connection without a knexfile	v
o	--migrations-directory	Set migrations directory without a knexfile	v
o	--migrations-table-name	Set migrations table name without a knexfile	v
o	--env	Environment, default: process.env.NODE_ENV || development	v
o	--esm	Enable ESM interop	v
o	--specific	Specify one seed file to execute	v
o	--timestamp-filename-prefix	Enable a timestamp prefix on name of generated seed files	v
o	--help	Display help for command	v
@	init
a	1	0
@	migrate:make
a	1	0
@	migrate:latest
a	1	0
@	migrate:up
a	1	0
@	migrate:rollback
a	1	0
@	migrate:down
a	1	0
@	migrate:currentVersion
a	1	0
@	migrate:unlock
a	1	0
@	seed:make
a	1	0
@	seed:run
a	1	0
@	help
a	1	0
