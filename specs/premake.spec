@	
s	clean	Remove all binaries and generated files
s	vs2022	Generate Visual Studio 2022 project files
s	vs2019	Generate Visual Studio 2019 project files
s	vs2017	Generate Visual Studio 2017 project files
s	vs2015	Generate Visual Studio 2015 project files
s	vs2013	Generate Visual Studio 2013 project files
s	vs2012	Generate Visual Studio 2012 project files
s	vs2010	Generate Visual Studio 2010 project files
s	vs2008	Generate Visual Studio 2008 project files
s	vs2005	Generate Visual Studio 2005 project files
s	gmake	Generate GNU Makefiles (This generator is deprecated by gmake2)
s	gmake2	Generate GNU Makefiles (including Cygwin and MinGW)
s	xcode4	Generate Apple Xcode 4 project files
s	codelite	Generate CodeLite project files
o	--help|-h	Shows a complete list of the actions supported	
o	--version	Display version information	
@	clean
o	--file	The premake5.lua file	v
o	--debugger	Start MobDebug remote debugger. Works with ZeroBrane Studio	
o	--fatal	Treat warnings from project scripts as errors	
o	--insecure	Forfit SSH certification checks	
o	--interactive	Interactive command prompt	
o	--os	Generate files for a different operating system	v
o	--scripts	Search for additional scripts on the given path	v
o	--systemscript	Override default system script (premake5-system.lua)	v
o	--verbose	Generate extra debug text output	
o	--cc	Choose a C/C++ compiler set	v
o	--dc	Choose a D compiler	v
o	--dotnet	Choose a .NET compiler set	v
=	clean	--file
t	filepaths
=	clean	--os
v	aix	
v	android	
v	bsd	
v	haiku	
v	hurd	
v	ios	
v	linux	
v	macosx	
v	solaris	
v	windows	
=	clean	--scripts
t	folders
=	clean	--systemscript
t	filepaths
=	clean	--cc
v	clang	
v	gcc	
v	mingw	
=	clean	--dc
v	dmd	
v	gdc	
v	ldc	
=	clean	--dotnet
v	mono	
v	msnet	
v	pnet	
