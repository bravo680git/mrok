@	
s	commands	Lists commands available in tmuxinator
s	completions	Used for shell completion
s	copy	Copy an existing project to a new project and open it in your editor
s	debug	Output the shell commands that are generated by tmuxinator
s	delete	Deletes given project
s	doctor	Look for problems in your configuration
s	help	Describe available commands or one specific command
s	implode	Deletes all tmuxinator projects
s	list	Lists all tmuxinator projects
s	local	Start a tmux session using ./.tmuxinator.y[a]ml
s	new	Create a new project file and open it in your editor
s	edit	Open a project file it in your editor
s	open	Open a project file it in your editor
s	start	Start a tmux session using a project's name (with an optional [ALIAS] for project reuse) or a path…
s	stop	Stop a tmux session using a project's tmuxinator config
s	version	Display installed tmuxinator version
@	commands
@	completions
@	copy
a	2	0
#	copy	1
d
#	copy	2
d
@	debug
o	-a|--attach	Attach to tmux session after creation	v
o	-n|--name	Give the session a different name	v
o	-p|--project-config	Path to project config file	v
=	debug	-p
t	folders,filepaths
@	delete
a	1	1
#	delete	1
d
@	doctor
@	help
a	1	0
#	help	1
t	help
@	implode
@	list
o	-n|--newline	Force output to be one entry per line	
@	local
o	--suppress-tmux-version-warning	Don't show a warning for unsupported tmux versions	
@	new
o	-l	Create local project file at ./.tmuxinator.y[a]ml	
a	2	0
#	new	2
d
@	edit
o	-l	Open local project file at ./.tmuxinator.y[a]ml	
a	1	0
#	edit	1
d
@	open
o	-l	Open local project file at ./.tmuxinator.y[a]ml	
a	1	0
#	open	1
d
@	start
a	1	0
#	start	1
d
@	stop
a	1	0
#	stop	1
d
@	version
