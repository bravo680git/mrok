@	
s	new|n	Creates a new nest project
s	generate|g	Generate and/or modifies files based on a schematic
s	build	Builds Nest application
s	start	Run Nest application
s	info|i	Display Nest project details
s	update|u	Update Nest dependencies
o	--help|-h	Show help for nest	
@	new
a	1	0
@	generate
s	application	Generate a new application workspace
s	class|cl	Generate a new class
s	configuration|config	Generate a CLI configuration file
s	controller|co	Generate a controller declaration
s	decorator|d	Generate a custom decorator
s	filter|f	Generate a filter declaration
s	gateway|ga	Generate a gateway declaration
s	guard|gu	Generate a guard declaration
s	interceptor|in	Generate an interceptor declaration
s	interface	Generate an interface
s	middleware|mi	Generate a middleware declaration
s	module|mo	Generate a module declaration
s	pipe|p	Generate a pipe declaration
s	provider|pr	Generate a provider declaration
s	resolver|r	Generate a GraphQL resolver declaration
s	service|s	Generate a service declaration
s	library|lib	Generate a new library within a monorepo
s	sub-app|app	Generate a new application within a monorepo
s	resource|res	Generate a new CRUD resource
@	generate application
o	-d|--dry-run	Report actions that would be taken without writing out results	
o	-p|--project	Project in which to generate files	v
o	--flat	Enforce flat structure of generated element	
o	--spec	Enforce spec files generation (default: true)	
o	--no-spec	Disable spec files generation	
o	-c|--collection	Schematics collection to use	v
